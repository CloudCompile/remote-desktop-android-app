<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Remote desktop servers are commonly reached over plain HTTP on the LAN
         (e.g. http://192.168.x.x:8090) or through Tailscale/Cloudflare tunnels
         (HTTPS). Cleartext is therefore allowed for user-configured hosts. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
